# Production Environment Configuration for Vercel
#
# IMPORTANT: Update VITE_API_URL after deploying backend to Hetzner VM
#
# Option 1: Use VM IP address directly (simplest)
# VITE_API_URL=http://YOUR_VM_IP:80
#
# Option 2: Use custom domain (recommended for production)
# VITE_API_URL=https://api.yourdomain.com
#
# For now, this is a placeholder - update after backend deployment

VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# Note: In Vercel dashboard, set the environment variable:
# VITE_API_URL=http://YOUR_HETZNER_VM_IP
# or
# VITE_API_URL=https://api.yourdomain.com
