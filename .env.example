# Database
DATABASE_URL=postgresql+asyncpg://attendance_user:your_password@localhost:5432/attendance_tracker

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie Configuration
COOKIE_SECURE=false  # Set to true in production (HTTPS)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=  # Leave empty for local dev, set to ".kotoio.fi" for production

# Documentation Authentication (used in production)
DOCS_USERNAME=admin
DOCS_PASSWORD=your-secure-password-here

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
DEBUG=True
