# The browser walk's build mode — `vite build --mode e2e`, which loads this file INSTEAD of
# .env.production.
#
# Why it has to exist. `npm run build` is `--mode production`, so it loads .env.production and
# bakes https://attendance-api.kotoio.fi into the bundle. A walk that mocks the API at the browser
# boundary would then be one missed route pattern away from talking to the real API — and the core
# loop POSTs attendance, so the failure mode is writing to a real teacher's register from a test.
# Vite's precedence puts .env.[mode] above .env.local, so this also survives a developer's own
# .env.local pointing somewhere else.
#
# Pointing the API at the preview server's own origin means a missed mock gets answered by
# `vite preview` instead of by production. e2e/fixtures.ts turns that into a red test rather than
# a silent one: everything under /api that no fixture claims is served a 501 and recorded.
VITE_API_URL=http://localhost:4174
