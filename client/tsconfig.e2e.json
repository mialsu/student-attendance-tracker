{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    /* vite/client, because e2e/fixtures.ts types its rows against src/api's own interfaces — a
       contract change then turns this gate red instead of a spec red at runtime. The cost is that
       the app's files join this program, and src/api/client.ts reads import.meta.env. */
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Playwright's own loader resolves what the walk imports. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strict, unlike tsconfig.app.json. The app's strictness is off and ADR-0005 records that this
       file therefore buys less here than the same sentence buys in a strict repo — but the walk is
       new code with no legacy to grandfather, so it is held to the rules the app cannot meet yet. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,

    /* Off, and not as a concession: importing src/api's types pulls the app's own files in here,
       where an unused import in src/api/attendance.ts would fail a gate about the walk. eslint
       runs over e2e/ with @typescript-eslint/no-unused-vars and a ratchet at 16, so unused code
       in the walk is still caught — by the tool whose scope is the walk's own files. */
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["playwright.config.ts", "e2e"]
}
