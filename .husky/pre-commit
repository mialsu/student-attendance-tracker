#!/usr/bin/env sh
# Gate set for client-app — /harness step 6. Every gate here was proven by breaking it on purpose
# before being wired; the evidence is in the /harness report and CODING_STANDARDS.md.
#
# Cheapest-first, so a failure surfaces fast. Same set as `npm run check`, except drift runs
# --cached (staged only) because that is what is actually about to land.
#
# Three of these are RATCHETS against .harness-baseline, not clean gates: the tree was red when the
# harness was installed. They fail when a count GROWS. See REVIEW-DEBT.md.
#
# Bypassing with `--no-verify` is a confession: it needs a REVIEW-DEBT.md entry.
#
# NOTE: husky's own default hook was `npm test`, which in this repo runs `vitest` in WATCH mode and
# would hang the commit forever. Do not restore it.
set -e

echo "▸ boundaries";          npm run --silent lint:boundaries
echo "▸ drift (staged)";      ./scripts/drift-check.sh --cached
echo "▸ vocab (staged)";      ./scripts/vocab-check.sh --cached
echo "▸ typecheck (ratchet)"; npm run --silent gate:typecheck
echo "▸ lint (ratchet)";      npm run --silent gate:lint
echo "▸ tests (ratchet)";     npm run --silent gate:tests
echo "▸ build";               npm run --silent build
echo "✔ gates green"
