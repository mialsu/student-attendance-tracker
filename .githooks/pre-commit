#!/usr/bin/env bash
# Root pre-commit dispatcher for the monorepo.
#
# WHY THIS EXISTS. Each package brought its own hook system from when it was a separate repository:
# api/ used .githooks via core.hooksPath, client/ used husky, which ALSO sets core.hooksPath. That
# setting is a single repository-wide value, so only one could ever be active — whichever was
# configured last won silently and the other package committed with no gates at all. The failure
# mode was the dangerous kind: you commit, see no complaint, and assume the gates ran.
#
# So: one hook, which looks at what is actually staged and runs only the gates that apply. A commit
# touching only docs runs nothing and is instant; a commit touching both packages runs both.
#
# Install once per clone:  git config core.hooksPath .githooks
# Bypassing with --no-verify is a confession: it needs a REVIEW-DEBT.md entry.
set -euo pipefail

# Resolve the tree being committed from GIT, not from where this script happens to live.
#
# This used to be `cd "$(dirname "${BASH_SOURCE[0]}")/.."`, and that is wrong the moment anyone
# commits from a `git worktree`. `core.hooksPath` holds ONE repository-wide value, and in this
# clone it is an ABSOLUTE path into the main checkout — `api/justfile`'s `install-hooks` writes it
# relative, which would have been fine, so something else made it absolute (husky's installer is
# the likely culprit; it owned this setting for client/ before the merge). Whatever the cause, an
# absolute value means every worktree's commit executes the MAIN checkout's copy of this file:
# `BASH_SOURCE[0]` points there, so the old line cd'd into the main checkout and ran
# `cd client && npm run …` against whatever *that* tree happened to contain.
#
# Git still exports `GIT_INDEX_FILE`, so `git diff --cached` below read the *correct* index and
# dispatched the *correct* packages. The gates ran, reported green, and had validated somebody
# else's working tree. Caught on 2026-09-10, when a worktree commit's boundary gate cruised 101
# modules while the same command run inside the worktree cruised 103 — the two files being
# committed were simply absent from what it checked.
#
# Fixing it here rather than by rewriting the config, because a config value is per-clone and any
# tool may rewrite it again; this line is correct however `core.hooksPath` is spelled.
#
# That is this header's own warning one level up: "you commit, see no complaint, and assume the
# gates ran." A gate pointed at the wrong tree is worse than no gate, because it answers.
#
# `--show-toplevel` is correct in both cases: git runs hooks from the top of the working tree being
# committed, and resolves this against the worktree's own gitdir rather than the common one.
cd "$(git rev-parse --show-toplevel)"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

run_api=0; run_client=0
grep -qE '^(api|deployment)/' <<<"$staged" && run_api=1
grep -qE '^client/'           <<<"$staged" && run_client=1

if [ "$run_api" -eq 0 ] && [ "$run_client" -eq 0 ]; then
  echo "pre-commit: nothing staged under api/, deployment/ or client/ — no gates apply."
  exit 0
fi

if [ "$run_api" -eq 1 ]; then
  echo "══ api ══"
  ( cd api && exec ./.githooks/pre-commit )
fi

if [ "$run_client" -eq 1 ]; then
  echo "══ client ══"
  # Mirrors what client/.husky/pre-commit ran before husky was removed. husky cannot work from a
  # subdirectory: its `prepare` script looks for .git beside package.json and errors on every
  # `npm ci` in a monorepo.
  cd client
  echo "▸ boundaries";           npm run --silent lint:boundaries
  echo "▸ drift (staged)";       ./scripts/drift-check.sh --cached
  echo "▸ drift-extra (staged)"; ./scripts/drift-extra.sh --cached
  echo "▸ typecheck (ratchet)";  npm run --silent gate:typecheck
  # The walk's own config and specs, held to tsconfig.e2e.json. Two seconds, and it closes the
  # hole this list has: the hook enumerates gates one by one and never calls `npm run check`, so a
  # gate added only to `check` reaches neither — which is exactly what happened to gate:a11y on
  # 2026-09-07. The browser walk itself stays OUT of here on purpose (ADR-0005): a hook that
  # punishes every commit trains people to reach for --no-verify.
  echo "▸ typecheck:e2e";           npm run --silent typecheck:e2e
  echo "▸ lint (ratchet)";       npm run --silent gate:lint
  echo "▸ a11y (ratchet)";       npm run --silent gate:a11y
  echo "▸ tests (ratchet)";      npm run --silent gate:tests
  echo "▸ build";                npm run --silent build
  echo "✔ client gates green"
fi
