# Production Environment Variables
# IMPORTANT: Copy this to .env and change all values!

# Database
POSTGRES_USER=attendance_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=attendance_tracker

# Backend API
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# CORS Configuration
# IMPORTANT: Add your Vercel deployment URL here after deploying frontend
# Format: CORS_ORIGINS=https://yourproject.vercel.app,https://yourdomain.com,http://localhost:5173
#
# Example with default Vercel domain:
# CORS_ORIGINS=https://student-attendance-tracker.vercel.app,http://localhost:5173
#
# Example with custom domain:
# CORS_ORIGINS=https://yourapp.vercel.app,https://app.yourdomain.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Domain (for SSL setup)
DOMAIN=yourdomain.com
EMAIL=your-email@example.com

# Observability — nothing to set here.
#
# Tracing is configured in docker-compose.yml, not in this file, because none of it is a secret
# and none of it varies per install: the API exports OTLP to the jaeger service on the internal
# network. See api/docs/adr/0006-opentelemetry-tracing.md.
#
# The UI is on the loopback interface only and has no login of its own. Reach it with:
#   ssh -L 16686:localhost:16686 <user>@<host>     # then http://localhost:16686
#
# This block used to hold `# SENTRY_DSN=` and `# MONITORING_ENDPOINT=` under "Optional: Enable if
# using external monitoring". Neither was ever read by anything in the repo.

# Basic auth for the API documentation (/docs, /redoc, /openapi.json).
# REQUIRED in production — the backend refuses to start without them. There is deliberately no
# fallback: the app used to default to admin/changeme, and production ran on that default for
# months because docker-compose.yml never passed these through.
DOCS_USERNAME=admin
DOCS_PASSWORD=generate-one-with-openssl-rand-base64-24
