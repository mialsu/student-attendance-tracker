# Test Environment Configuration
# Copy this file to .env.test for local testing.

# Test Database
#
# PREFER THE HELPER. It starts a disposable PostgreSQL on port 5439, creates the database and
# prints the export line, and `just test-db-down` destroys it:
#
#   eval "$(just test-db-up)"
#   just check
#   just test-db-down
#
# If you set this by hand, know what you are pointing at: these fixtures call `drop_all`, so a
# wrong host or port DESTROYS whatever schema answers.
TEST_DATABASE_URL=postgresql+asyncpg://attendance_user:test_password_123@localhost:5439/attendance_tracker_test

# NEVER use port 5433. On the Owner's machine that is `platform-postgres`, a different project's
# database. This file recommended it until 2026-09-02, when /audit found that both this example
# and conftest.py's error message still named it after the unsafe default had been removed.

# For CI/CD (GitHub Actions), where PostgreSQL is a service container on the standard port:
# TEST_DATABASE_URL=postgresql+asyncpg://attendance_user:test_password@localhost:5432/attendance_tracker_test
