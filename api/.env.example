# Database
DATABASE_URL=postgresql+asyncpg://attendance_user:your_password@localhost:5432/attendance_tracker

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie Configuration
COOKIE_SECURE=false  # Set to true in production (HTTPS)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=  # Leave EMPTY everywhere, including production. A host-only refresh cookie
                # reaches the API and nothing else; a parent domain hands it to every sibling host.

# Documentation Authentication — gates /docs, /redoc and /openapi.json.
# REQUIRED whenever ENVIRONMENT is not `development` (or DEBUG is off): the app refuses to start
# without both, by design. There used to be a fallback of admin/changeme, and production ran on
# it for months because the compose file never passed these through. Left blank here because
# local development with DEBUG=True serves the docs unauthenticated and never reads them.
DOCS_USERNAME=
DOCS_PASSWORD=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging (spec 0005). Governs the whole `app` logger. Case and whitespace do not matter, and an
# unrecognised value falls back to INFO rather than silencing the log.
#
# Leave it unset unless you have a reason. Raising it loses records. The merge and student-delete
# audit lines are INFO, so at `WARNING` or above they stop being written while denials and errors
# keep flowing, which leaves the log reading as healthy with the record of the two irreversible
# operations missing. Production sets nothing here, on purpose.
# LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
DEBUG=True
